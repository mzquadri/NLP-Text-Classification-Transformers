# Data
data/
*.csv
*.tsv
*.parquet

# Models. Trained artifacts are not committed; they are large and rebuildable.
# results/benchmark.json records each one's file names, sizes and content hashes
# so a reported number can still be traced to the artifact that produced it.
models/
*.bin
*.pt
*.pth
*.safetensors
*.joblib

# Results (keep directory). benchmark.json is the evidence the README is bound
# to and scripts/check_repository.py verifies against, so it is tracked.
results/*.png
results/*.json
!results/benchmark.json

# Hugging Face cache
.cache/

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# Environment
.env
.venv/
env/
venv/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
wandb/
mlruns/
